# Server
PORT=3100
DB_PATH=./data/requestor.sqlite
# Comma-separated origins allowed to POST reports. "*" allows any (fine for local dev).
ALLOWED_ORIGINS=*
# Public URL of this server; used to link back to the full report from the Linear issue.
PUBLIC_BASE_URL=http://localhost:3100
# Optional: if set, GET /api/bugs* requires "Authorization: Bearer <token>".
ADMIN_TOKEN=

# Linear (leave LINEAR_API_KEY blank to run in log-only mode)
LINEAR_API_KEY=
# Team key is the short prefix on issue ids, e.g. "ENG" for ENG-123. Or set LINEAR_TEAM_ID directly.
LINEAR_TEAM_KEY=
LINEAR_TEAM_ID=
# Comma-separated label names to attach (must already exist in the team/workspace).
LINEAR_LABELS=Bug

# Coding agent. AGENT_BACKEND: none | copilot | claude-routine | linear-delegate
# Reports are handed off only via POST /api/bugs/:id/dispatch unless AGENT_AUTO_DISPATCH=true.
AGENT_BACKEND=none
AGENT_AUTO_DISPATCH=false
# copilot: GitHub Copilot cloud agent (Agent Tasks API). Token needs "Agent tasks" read/write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/name
GITHUB_BASE_REF=main
COPILOT_MODEL=
# claude-routine: fire URL + per-routine token from claude.ai/code/routines (API trigger).
CLAUDE_ROUTINE_FIRE_URL=
CLAUDE_ROUTINE_TOKEN=
# linear-delegate: app-user id of an agent installed in your Linear workspace (Copilot, Cursor, Codex, Devin...).
LINEAR_DELEGATE_ID=
